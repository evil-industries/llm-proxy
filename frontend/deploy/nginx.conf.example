# Install in nginx's http context. Replace hostname and certificate paths.
# ORIGIN on the Node process must be https://management.example.com.
# Preserve existing inference ingress separately; Node does not forward inference.
# nginx-inference.conf.example provides an optional separate API hostname.
server {
    listen 80;
    server_name management.example.com;
    return 308 https://management.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name management.example.com;

    ssl_certificate /etc/letsencrypt/live/management.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/management.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 0;

    # Send every route, including /api/management, through authenticated Node.
    # Never add a public location that proxies /v0/management to the Go server.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
