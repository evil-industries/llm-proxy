# Optional inference hostname, installed alongside nginx.conf.example in http {}.
# Replace hostname and certificate paths. Go must be reachable only privately or
# on loopback, with a nonempty api-keys list. Forward client keys, never the
# backend management key. Existing inference ingress can be retained instead.
map $http_upgrade $management_inference_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name api.example.com;
    return 308 https://api.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name api.example.com;

    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 0;

    # Management is reachable only through the console's authenticated relay.
    location ^~ /v0/ {
        return 404;
    }

    # OpenAI, Claude, Gemini, video, and Codex inference routes in Go.
    location ~ ^/(v1|v1beta|openai/v1|backend-api/codex)(/|$) {
        proxy_pass http://127.0.0.1:8317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $management_inference_connection;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    # Includes /management.html, OAuth callbacks, and unlisted integrations.
    # Preserve any required integration routes explicitly in existing ingress.
    location / {
        return 404;
    }
}
