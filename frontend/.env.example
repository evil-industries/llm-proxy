# Set these on the Go service. Vite never consumes server secrets.
CONSOLE_ENABLED=true
CONSOLE_STATIC_DIR=frontend/build
ORIGIN=https://management.example.com
AUTH_MODE=password
# Generate with npm run auth:hash; single quotes preserve dollar signs.
AUTH_PASSWORD_HASH=''

# OIDC mode disables password login and requires all four values.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=llm-proxy-management
# OIDC_CLIENT_SECRET=''
# OIDC_ALLOWED_USERS=alice,bob

# Vite development: set ORIGIN=http://127.0.0.1:5173 on the Go process.
# Node is only needed for development and asset builds.
