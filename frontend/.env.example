# Local development. npm run dev loads .env; production node build does not.
# For production use the actual public HTTPS origin, without a trailing slash.
ORIGIN=http://localhost:5173

# Generate using node scripts/hash-password.mjs (interactive input is hidden).
# Keep the entire generated value in single quotes to preserve dollar signs.
AUTH_PASSWORD_HASH=''

# Server-only backend configuration: browser users never receive this key.
# Use a container DNS name in Compose, e.g. http://cli-proxy-api:8317.
PRIVATE_MANAGEMENT_URL=http://127.0.0.1:8317
PRIVATE_MANAGEMENT_KEY=''

# Compose only: existing private network shared with the Go backend.
MANAGEMENT_NETWORK=management-backend

# Authenticated management payloads have no application size limit.
BODY_SIZE_LIMIT=Infinity
