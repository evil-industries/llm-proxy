{
  "name": "management-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "garden": "garden",
    "garden:check": "node scripts/garden-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node server.mjs",
    "auth:hash": "node scripts/hash-password.mjs",
    "test:server": "node scripts/smoke-server.mjs",
    "deploy:setup": "node scripts/setup-compose.mjs",
    "deploy:test": "node --test scripts/setup-compose.test.mjs",
    "test:proxy": "node scripts/smoke-caddy.mjs",
    "test:compose": "node scripts/smoke-compose.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@gardenjs/render-plugin-svelte": "^2.0.1",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.13.0",
    "gardenjs": "1.6.2",
    "layerchart": "^2.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.104.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.1"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "cookie": "^0.7.2"
  }
}
